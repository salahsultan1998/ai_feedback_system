{
  "game": "Baloot",
  "label_system_name": "Baloot反馈标签",
  "exclusion_reasons": [
    "缺少明确反馈对象或诉求",
    "内容无法理解",
    "含辱骂内容"
  ],
  "terminology": {
    "对局规则举报": {
      "ar_variants": [
        "قيد",
        "تقييد",
        "التقييد",
        "يقيد",
        "يقييد"
      ],
      "definition": "在打牌过程中，玩家认为他人未按规则出牌时，可以主动发起规则举报，由系统判断；举报成立后，被举报方才受到处罚。随意发起举报可能干扰对手和队友。",
      "translation_notes": [
        "在牌局规则语境中可用说明性中文“对局规则举报”，该含义已经业务确认。",
        "保留玩家发起、系统判断的主体关系，不能译成系统主动限制玩家或限制玩法。",
        "未给出裁定结果时，不补写举报成立或已处罚；玩家认为对方恶意举报时，保留其主张，不认定作弊已经证实。",
        "同一阿语词在其他语境中可能表示普通限制，应结合上下文判断，不无条件替换。"
      ]
    },
    "打光头": {
      "ar_variants": [
        "كبوت"
      ],
      "definition": "使对方在牌局中得零分，即业务确认的全胜结果。团队固定中文称呼为“打光头”。",
      "translation_notes": [
        "统一使用“打光头”，不再将该术语译为“全墩”。",
        "根据原文区分打光头、被打光头、即将打光头和阻止打光头，保留双方主体及是否已经发生的区别。",
        "不要据此推断作弊、处罚、计分规则或其他未在原文说明的结果。"
      ]
    },
    "project": {
      "ar_variants": [
        "مشروع",
        "مشاريع"
      ],
      "definition": "在牌局或欢乐场的项目语境中，团队允许使用英文 project。project 400 保留数字 400，不擅自补充金币、价格或其他单位。",
      "translation_notes": [
        "只有上下文支持时才按游戏术语翻译，不能把所有包含该词的内容都认定为欢乐场。"
      ]
    },
    "欢乐场": {
      "ar_variants": [
        "تحدي المشاريع"
      ],
      "definition": "业务确认的玩法名称，中文统一为欢乐场。"
    },
    "许愿树": {
      "ar_variants": [
        "شجرة الامنيات",
        "شجرة الأمنيات"
      ],
      "definition": "业务确认的活动名称，中文统一为许愿树。付费后未收到商品的反馈按充值主诉求分类。"
    },
    "沙漠寻宝": {
      "ar_variants": [
        "كنز الصحراء",
        "خريطة"
      ],
      "definition": "业务确认的样例中，玩家所说的地图活动是沙漠寻宝。仅在对应活动语境采用，不能把任意地图相关文字都替换为该活动名。"
    }
  },
