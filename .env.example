# Production template. Store the completed copy at /etc/ai-feedback.env (mode 0600).
# For local development, only OPENROUTER_API_KEY is required in the project's .env.
FEEDBACK_ENV=production
FEEDBACK_STORAGE=/var/lib/ai-feedback
FEEDBACK_ALLOWED_HOSTS=feedback.example.com
FEEDBACK_BEHIND_PROXY=true
FEEDBACK_SECURE_COOKIES=true
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
FLASK_SECRET_KEY=

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Required when using the configured Baloot Feishu integration:
FEISHU_BALOOT_WEBHOOK=
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional Xinjiang bot; also enable feishu.enabled in config/xinjiang/settings.json:
FEISHU_XINJIANG_WEBHOOK=
