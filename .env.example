# Production template. Store the completed copy at /etc/ai-feedback.env (mode 0600).
# For local development, only OPENROUTER_API_KEY is required in the project's .env.
FEEDBACK_ENV=production
FEEDBACK_STORAGE=/var/lib/ai-feedback
FEEDBACK_ALLOWED_HOSTS=feedback.example.com
FEEDBACK_BEHIND_PROXY=true
FEEDBACK_SECURE_COOKIES=true
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
FLASK_SECRET_KEY=

# Platform login (enabled by default in production).
# Copy the public project settings from AI Translation. Do not use a service role key.
FEEDBACK_AUTH_ENABLED=true
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
FEEDBACK_ALLOWED_EMAILS=

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional project configuration passwords. Use a different random password for each game.
FEEDBACK_PROMPT_PASSWORD_BALOOT=
FEEDBACK_PROMPT_PASSWORD_XINJIANG=
FEEDBACK_PROMPT_PASSWORD_OKEY=

# Required when using the configured Baloot Feishu integration:
FEISHU_BALOOT_WEBHOOK=
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional Xinjiang bot; also enable feishu.enabled in config/xinjiang/settings.json:
FEISHU_XINJIANG_WEBHOOK=

# Optional Okey integration; enable it and set the destination in config/okey/settings.json.
FEISHU_OKEY_WEBHOOK=
FEISHU_APP_ID_OKEY=
FEISHU_APP_SECRET_OKEY=
